{
  "name": "tcp",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "description": "Tcp",
  "author": "Your Name",
  "productName": "Tcp",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "electron:serve": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env NODE_ENV=production npm run build && npx electron-builder",
    "electron:build:win": "cross-env NODE_ENV=production npm run build && npx electron-builder --win --x64",
    "electron:build:mac": "cross-env NODE_ENV=production npm run build && npx electron-builder --mac",
    "electron:build:linux": "cross-env NODE_ENV=production npm run build && npx electron-builder --linux",
    "electron:build:linux-arm64": "cross-env NODE_ENV=production npm run build && npx electron-builder --linux --arm64",
    "electron:start": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "forge-build-linux-arm64": "electron-forge make --platform=linux --arch=arm64 --targets=\"@electron-forge/maker-zip\"",
    "forge-build-win": "electron-forge make --platform=win32 --arch=x64 --targets=\"@electron-forge/maker-zip\""
  },
  "build": {
    "appId": "com.yourcompany.tcp",
    "productName": "Tcp",
    "copyright": "Copyright © 2025 ${author}",
    "electronVersion": "39.2.4",
    "directories": {
      "output": "electron_dist",
      "buildResources": "public"
    },
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/.bin/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,LICENSE,LICENSE.txt}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,demo}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/*.map",
      "!**/node_modules/*.md",
      "!**/node_modules/*.yml",
      "!**/node_modules/*.yaml",
      "!**/node_modules/sass-embedded/**",
      "!**/node_modules/vite-plugin-imagemin/**"
    ],
    "extraResources": [
      {
        "from": "public/kr1",
        "to": "kr1",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/assets/music",
        "to": "assets/music",
        "filter": [
          "**/*.mp3"
        ]
      }
    ],
    "asar": false,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "src/assets/music/**"
    ],
    "compression": "store",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "public/home.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/home.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "executableName": "Tcp"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "zip"
      ],
      "icon": "public/home.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-arm64.${ext}",
      "executableName": "Tcp",
      "maintainer": "Your Name <your.email@example.com>",
      "asarUnpack": [
        "**/*.node",
        "src/assets/music/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tcp",
      "installerIcon": "public/home.ico",
      "uninstallerIcon": "public/home.ico",
      "installerHeaderIcon": "public/home.ico",
      "license": "LICENSE.txt",
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "asarUnpack": [
          "**/*.node",
          "**/*.dll",
          "src/assets/music/**"
        ],
        "executableName": "Tcp",
        "icon": "public/home",
        "ignore": [],
        "copyIgnore": [],
        "prune": false,
        "noPrune": true,
        "skipNativeRebuild": true,
        "ignoreNativeModules": true,
        "platform": "linux",
        "arch": "arm64"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "linux",
            "win32"
          ]
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        }
      ]
    }
  },
  "dependencies": {
    "@chenfengyuan/vue-countdown": "^2.1.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@serialport/parser-inter-byte-timeout": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "axios": "^1.7.9",
    "can": "^6.6.3",
    "crypto-js": "^4.2.0",
    "dplayer": "^1.27.1",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.9.0",
    "human-signals": "^8.0.1",
    "i2c-bus": "^5.2.3",
    "loudness": "^0.4.2",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.2.0",
    "serialport": "^13.0.0",
    "swiper": "^11.2.5",
    "three": "^0.180.0",
    "urdf-loader": "^0.12.7",
    "vue": "^3.5.25",
    "vue-router": "^4.5.0",
    "vue3-virtual-keyboard-cn": "^1.0.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.85.1",
    "sass-embedded": "^1.86.0",
    "terser": "^5.44.1",
    "unplugin-auto-import": "^19.1.1",
    "unplugin-element-plus": "^0.9.1",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.0.1",
    "vite-plugin-imagemin": "^0.6.1",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}